{
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "app.mayonrentacar.com.ph"
        }
      ],
      "dest": "/Public/dashboard"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/Public"
    },
    {
      "source": "/dashboard",
      "destination": "/Public/dashboard"
    },
    {
      "source": "/dashboard.html",
      "destination": "/Public/dashboard"
    },
    {
      "source": "/customer-dashboard",
      "destination": "/Public/customer-dashboard"
    },
    {
      "source": "/customer-dashboard.html",
      "destination": "/Public/customer-dashboard"
    },
    {
      "source": "/affiliate-dashboard",
      "destination": "/Public/affiliate-dashboard"
    },
    {
      "source": "/affiliate-dashboard.html",
      "destination": "/Public/affiliate-dashboard"
    },
    {
      "source": "/about",
      "destination": "/Public/about"
    },
    {
      "source": "/services",
      "destination": "/Public/services"
    },
    {
      "source": "/fleet",
      "destination": "/Public/fleet"
    },
    {
      "source": "/contact-us",
      "destination": "/Public/contact-us"
    },
    {
      "source": "/faq",
      "destination": "/Public/faq"
    },
    {
      "source": "/terms-of-use",
      "destination": "/Public/terms-of-use"
    },
    {
      "source": "/self-drive-rental",
      "destination": "/Public/self-drive-rental"
    },
    {
      "source": "/with-driver-rental",
      "destination": "/Public/with-driver-rental"
    },
    {
      "source": "/airport-transfers",
      "destination": "/Public/airport-transfers"
    },
    {
      "source": "/inbound-outbound-transfers",
      "destination": "/Public/inbound-outbound-transfers"
    },
    {
      "source": "/app.js",
      "destination": "/Public/app.js"
    },
    {
      "source": "/auth-utils.js",
      "destination": "/Public/auth-utils.js"
    },
    {
      "source": "/dashboard.js",
      "destination": "/Public/dashboard.js"
    },
    {
      "source": "/styles.css",
      "destination": "/Public/styles.css"
    },
    {
      "source": "/dashboard-style.css",
      "destination": "/Public/dashboard-style.css"
    },
    {
      "source": "/account-dashboard.js",
      "destination": "/Public/account-dashboard.js"
    },
    {
      "source": "/account-dashboard.css",
      "destination": "/Public/account-dashboard.css"
    },
    {
      "source": "/robots.txt",
      "destination": "/Public/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/Public/sitemap.xml"
    },
    {
      "source": "/images/:path*",
      "destination": "/Public/images/:path*"
    },
    {
      "source": "/images.2/:path*",
      "destination": "/Public/images.2/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.mayonrentacar.com.ph/api/:path*"
    }
  ]
}
